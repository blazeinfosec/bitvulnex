# Normalize line endings to LF in the repository; check out native on
# each platform. Silences the LF/CRLF warnings on Windows checkouts.
* text=auto
*.sh text eol=lf
Makefile text eol=lf
# Key material is read as raw bytes (HMAC secret / PEM). A CRLF checkout
# on Windows changes those bytes and breaks signature verification.
apps/web/keys/** -text
