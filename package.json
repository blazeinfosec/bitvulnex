{
  "name": "bitvulnex",
  "version": "0.0.0",
  "private": true,
  "description": "Bitvulnex — a deliberately vulnerable Bitcoin exchange (authorized security education lab)",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "pnpm --filter @bvbe/db seed",
    "flags": "tsx scripts/derive-flags.ts",
    "hints-doc": "tsx scripts/compile-hints.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
