// Prisma schema for BVBE.
//
// Phase 1 extends the User model and adds RefreshToken,
// PasswordResetToken, ApiKey. Subsequent phases extend additively.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  support
  compliance
  admin
  treasury
}

enum KycStatus {
  incomplete
  pending
  approved
  rejected
}

enum KycDocType {
  passport
  id_card
  address_proof
}

enum KycDocSource {
  upload
  url_import
}

enum DepositStatus {
  seen
  confirming
  credited
  dropped
}

enum OrderSide {
  buy
  sell
}

enum OrderType {
  limit
  market
  stop_limit
  oco
}

enum OrderStatus {
  open
  partial
  filled
  cancelled
}

enum PositionSide {
  long
  short
}

enum PositionStatus {
  open
  liquidated
  closed
}

enum LendingSide {
  supply
  borrow
}

enum LendingStatus {
  open
  closed
}

enum StakingStatus {
  active
  unstaking
  ended
}

enum OtcStatus {
  requested
  quoted
  accepted
  filled
  cancelled
  expired
}

enum P2PStatus {
  open
  paused
  filled
  cancelled
}

enum P2PTradeStatus {
  pending_payment
  paid
  released
  disputed
  cancelled
}

// Phase 7 — withdrawal pipeline & treasury coordinator.
//
// WithdrawalStatus state machine:
//   pending      — submitted; limit + balance checks passed
//   approved     — manual approval step (lab auto-approves)
//   broadcasting — worker has drafted the TX; awaiting broadcast
//   broadcast    — TX submitted to the mock node
//   confirming   — seen 1+ confirmations
//   confirmed    — settled (lab uses 1 confirmation)
//   rejected     — failed validation
//   bumped       — fee-bumped via RBF; original dropped
//   failed       — unrecoverable
enum WithdrawalStatus {
  pending
  approved
  broadcasting
  broadcast
  confirming
  confirmed
  rejected
  bumped
  failed
}

enum TreasuryDraftStatus {
  drafted
  partial
  signed
  broadcast
  failed
}

enum SupportTicketStatus {
  open
  awaiting_user
  awaiting_agent
  resolved
  closed
}

enum SupportTicketCategory {
  general
  account
  deposit
  withdrawal
  trading
  kyc
  security
}

enum ComplianceCaseStatus {
  open
  in_review
  escalated
  resolved
  dismissed
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  displayName        String?
  role               Role      @default(user)
  kycTier            Int       @default(0)
  emailVerified      Boolean   @default(false)
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  keeperRegisteredAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResets      PasswordResetToken[]
  apiKeys             ApiKey[]
  kycProfile          KycProfile?
  kycDocuments        KycDocument[]
  btcAddresses        BitcoinAddress[]
  deposits            Deposit[]
  balances            Balance[]
  orders              Order[]
  tradesAsTaker       Trade[]              @relation("trade_taker")
  tradesAsMaker       Trade[]              @relation("trade_maker")
  marginPositions     MarginPosition[]
  liquidationsClaimed Liquidation[]        @relation("liquidation_keeper")
  lendingPositions    LendingPosition[]
  stakingPositions    StakingPosition[]
  otcTickets          OtcTicket[]
  p2pOffers           P2POffer[]
  p2pTradesAsBuyer    P2PTrade[]           @relation("p2p_buyer")
  p2pTradesAsSeller   P2PTrade[]           @relation("p2p_seller")
  withdrawals         Withdrawal[]
  withdrawalLimits    WithdrawalLimitLedger[]
  internalTransfersOut InternalTransfer[]  @relation("internal_transfer_from")
  internalTransfersIn  InternalTransfer[]  @relation("internal_transfer_to")
  treasuryDrafts      TreasuryDraft[]      @relation("treasury_draft_author")
  treasurySignatures  TreasurySignature[]  @relation("treasury_signature_signer")
  tickets                   SupportTicket[]
  ticketMessages            SupportTicketMessage[]
  complianceCasesAsSubject  ComplianceCase[]       @relation("compliance_subject")
  complianceCasesAsOpener   ComplianceCase[]       @relation("compliance_opener")
  adminAuditLogs            AdminAuditLog[]
  equitySnapshots           EquitySnapshot[]

  @@map("users")
}

model BitcoinAddress {
  id              String   @id @default(cuid())
  userId          String
  asset           String
  address         String   @unique
  derivationIndex Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, asset])
  @@map("bitcoin_addresses")
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String
  asset         String
  address       String
  txid          String
  vout          Int
  amount        Decimal       @db.Decimal(38, 8)
  confirmations Int
  status        DepositStatus @default(seen)
  seenAt        DateTime      @default(now())
  creditedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([txid, vout])
  @@index([userId])
  @@index([address])
  @@map("deposits")
}

// Balance semantics (Phase-5 fix-up Q-5.4):
//   amount          = spot subtotal: available + locked. NOT a
//                     grand total across all sub-accounts.
//   available       = spot free balance (depositable, withdrawable)
//   locked          = spot reserved against open orders
//   marginAvailable = margin sub-account free (backs new positions)
//   marginBorrowed  = platform borrow against open positions
//                     (NOT user-owned; informational)
// Phase 6 may add lending/staking buckets; keep them as new columns
// rather than overloading any of the above.
model Balance {
  id              String   @id @default(cuid())
  userId          String
  asset           String
  amount          Decimal  @default(0) @db.Decimal(38, 8)
  available       Decimal  @default(0) @db.Decimal(38, 8)
  locked          Decimal  @default(0) @db.Decimal(38, 8)
  marginAvailable Decimal  @default(0) @db.Decimal(38, 8)
  marginBorrowed  Decimal  @default(0) @db.Decimal(38, 8)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset])
  @@index([userId])
  @@map("balances")
}

model TradingPair {
  id           String  @id @default(cuid())
  base         String
  quote        String
  active       Boolean @default(true)
  minOrderSize Decimal @db.Decimal(38, 8)
  priceTick    Decimal @db.Decimal(38, 8)

  @@unique([base, quote])
  @@map("trading_pairs")
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      String
  pair        String
  side        OrderSide
  type        OrderType
  price       Decimal?    @db.Decimal(38, 8)
  amount      Decimal     @db.Decimal(38, 8)
  filled      Decimal     @default(0) @db.Decimal(38, 8)
  status      OrderStatus @default(open)
  stopTrigger Decimal?    @db.Decimal(38, 8)
  ocoPairId   Int?
  feeTier     String      @default("base")
  createdAt   DateTime    @default(now())
  cancelledAt DateTime?

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  takerTrades Trade[] @relation("trade_taker_order")
  makerTrades Trade[] @relation("trade_maker_order")

  @@index([userId])
  @@index([pair, status])
  @@map("orders")
}

model Trade {
  id           Int      @id @default(autoincrement())
  pair         String
  takerOrderId Int
  makerOrderId Int
  takerUserId  String
  makerUserId  String
  price        Decimal  @db.Decimal(38, 8)
  amount       Decimal  @db.Decimal(38, 8)
  takerFeeBps  Int
  makerFeeBps  Int
  executedAt   DateTime @default(now())

  takerOrder Order @relation("trade_taker_order", fields: [takerOrderId], references: [id], onDelete: Restrict)
  makerOrder Order @relation("trade_maker_order", fields: [makerOrderId], references: [id], onDelete: Restrict)
  takerUser  User  @relation("trade_taker", fields: [takerUserId], references: [id], onDelete: Cascade)
  makerUser  User  @relation("trade_maker", fields: [makerUserId], references: [id], onDelete: Cascade)

  @@index([pair, executedAt])
  @@index([takerUserId])
  @@index([makerUserId])
  @@map("trades")
}

model KycProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  legalName       String?
  dateOfBirth     DateTime?
  country         String?
  addressLine     String?
  city            String?
  postalCode      String?
  status          KycStatus @default(incomplete)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_profiles")
}

model KycDocument {
  id         String       @id @default(cuid())
  userId     String
  type       KycDocType
  filename   String
  storedPath String
  mimeType   String
  size       Int
  source     KycDocSource @default(upload)
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_documents")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model MarginPosition {
  id               Int            @id @default(autoincrement())
  userId           String
  pair             String
  side             PositionSide
  size             Decimal        @db.Decimal(38, 8)
  entryPrice       Decimal        @db.Decimal(38, 8)
  leverage         Int
  collateralAsset  String
  collateral       Decimal        @db.Decimal(38, 8)
  liquidationPrice Decimal        @db.Decimal(38, 8)
  status           PositionStatus @default(open)
  openedAt         DateTime       @default(now())
  closedAt         DateTime?
  closedPrice      Decimal?       @db.Decimal(38, 8)
  realizedPnl      Decimal?       @db.Decimal(38, 8)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  liquidation Liquidation?

  @@index([userId])
  @@index([pair, status])
  @@map("margin_positions")
}

model Liquidation {
  id           Int       @id @default(autoincrement())
  positionId   Int       @unique
  triggerPrice Decimal   @db.Decimal(38, 8)
  keeperUserId String?
  keeperRebate Decimal   @db.Decimal(38, 8)
  flaggedAt    DateTime  @default(now())
  claimedAt    DateTime?

  position MarginPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  keeper   User?          @relation("liquidation_keeper", fields: [keeperUserId], references: [id], onDelete: SetNull)

  @@index([keeperUserId])
  @@map("liquidations")
}

// Phase 6 — yield, OTC desk, and P2P escrow.
//
// Lending and staking deliberately live as separate sub-accounts from
// the spot+margin balances. Supplied principal moves OUT of
// Balance.amount/available and INTO LendingPosition.principal (same
// shape for staking). Interest credits then hit Balance.available
// (and amount) directly so users can re-deploy yield without an
// explicit withdraw step.
model LendingPool {
  id          String   @id @default(cuid())
  asset       String   @unique
  supplied    Decimal  @default(0) @db.Decimal(38, 8)
  borrowed    Decimal  @default(0) @db.Decimal(38, 8)
  reserve     Decimal  @default(0) @db.Decimal(38, 8)
  apyBaseBps  Int
  apySlopeBps Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastAccrual DateTime @default(now())

  @@map("lending_pools")
}

model LendingPosition {
  id              String        @id @default(cuid())
  userId          String
  pool            String
  side            LendingSide
  principal       Decimal       @db.Decimal(38, 8)
  accrued         Decimal       @default(0) @db.Decimal(38, 8)
  collateralAsset String?
  collateral      Decimal?      @db.Decimal(38, 8)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  status          LendingStatus @default(open)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pool])
  @@index([pool, status])
  @@map("lending_positions")
}

model StakingProgram {
  id            String   @id @default(cuid())
  asset         String   @unique
  rewardAsset   String
  apyBps        Int
  active        Boolean  @default(true)
  windowSeconds Int
  createdAt     DateTime @default(now())

  @@map("staking_programs")
}

model StakingPosition {
  id         String        @id @default(cuid())
  userId     String
  asset      String
  principal  Decimal       @db.Decimal(38, 8)
  startedAt  DateTime      @default(now())
  unstakedAt DateTime?
  status     StakingStatus @default(active)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims StakingClaim[]

  @@index([userId])
  @@index([asset, status])
  @@map("staking_positions")
}

model StakingClaim {
  id          String    @id @default(cuid())
  positionId  String
  amount      Decimal   @db.Decimal(38, 8)
  windowStart DateTime
  windowEnd   DateTime
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  position StakingPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@map("staking_claims")
}

model OtcTicket {
  id             String    @id @default(cuid())
  userId         String
  pair           String
  side           OrderSide
  amount         Decimal   @db.Decimal(38, 8)
  quotedPrice    Decimal?  @db.Decimal(38, 8)
  status         OtcStatus @default(quoted)
  quoteExpiresAt DateTime?
  filledAt       DateTime?
  feeBps         Int?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("otc_tickets")
}

model P2POffer {
  id        String    @id @default(cuid())
  userId    String
  side      OrderSide
  asset     String
  amount    Decimal   @db.Decimal(38, 8)
  price     Decimal   @db.Decimal(38, 8)
  payMethod String
  status    P2PStatus @default(open)
  createdAt DateTime  @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades P2PTrade[]

  @@index([asset, status])
  @@map("p2p_offers")
}

model P2PTrade {
  id           String         @id @default(cuid())
  offerId      String
  buyerUserId  String
  sellerUserId String
  amount       Decimal        @db.Decimal(38, 8)
  price        Decimal        @db.Decimal(38, 8)
  asset        String
  status       P2PTradeStatus @default(pending_payment)
  createdAt    DateTime       @default(now())
  releasedAt   DateTime?
  disputedAt   DateTime?

  offer  P2POffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  buyer  User     @relation("p2p_buyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  seller User     @relation("p2p_seller", fields: [sellerUserId], references: [id], onDelete: Cascade)

  @@index([buyerUserId])
  @@index([sellerUserId])
  @@map("p2p_trades")
}

model Withdrawal {
  id             String           @id @default(cuid())
  userId         String
  asset          String
  amount         Decimal          @db.Decimal(38, 8)
  fee            Decimal          @db.Decimal(38, 8)
  destAddress    String
  status         WithdrawalStatus @default(pending)
  txid           String?
  replacedByTxid String?
  requestedAt    DateTime         @default(now())
  approvedAt     DateTime?
  broadcastAt    DateTime?
  confirmedAt    DateTime?
  failedReason   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([txid])
  @@map("withdrawals")
}

// One row per (user, UTC day, asset). Maintains the running total of
// withdrawals attributed to that day so the daily limit check is a
// single indexed read.
model WithdrawalLimitLedger {
  id         String   @id @default(cuid())
  userId     String
  utcDate    DateTime @db.Date
  asset      String
  totalCents BigInt   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, utcDate, asset])
  @@index([userId, utcDate])
  @@map("withdrawal_limit_ledger")
}

model InternalTransfer {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  asset      String
  amount     Decimal  @db.Decimal(38, 8)
  memo       String?
  createdAt  DateTime @default(now())

  fromUser User @relation("internal_transfer_from", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("internal_transfer_to",   fields: [toUserId],   references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@map("internal_transfers")
}

model TreasuryDraft {
  id              String              @id @default(cuid())
  authorUserId    String
  psbtBase64      String
  intentNote      String?
  intendedOutputs Json
  status          TreasuryDraftStatus @default(drafted)
  createdAt       DateTime            @default(now())
  broadcastTxid   String?
  broadcastAt     DateTime?

  author     User                @relation("treasury_draft_author", fields: [authorUserId], references: [id], onDelete: Restrict)
  signatures TreasurySignature[]

  @@index([status])
  @@map("treasury_drafts")
}

model TreasurySignature {
  id           String   @id @default(cuid())
  draftId      String
  signerUserId String
  signedAt     DateTime @default(now())

  draft  TreasuryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  signer User          @relation("treasury_signature_signer", fields: [signerUserId], references: [id], onDelete: Restrict)

  @@unique([draftId, signerUserId])
  @@map("treasury_signatures")
}

model SupportTicket {
  id        String                @id @default(cuid())
  userId    String
  category  SupportTicketCategory @default(general)
  subject   String
  status    SupportTicketStatus   @default(open)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  closedAt  DateTime?

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  isAgent   Boolean  @default(false)
  bodyMd    String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model ComplianceCase {
  id            String               @id @default(cuid())
  subjectUserId String
  openedById    String?
  status        ComplianceCaseStatus @default(open)
  notes         String?
  createdAt     DateTime             @default(now())
  resolvedAt    DateTime?

  subject  User  @relation("compliance_subject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  openedBy User? @relation("compliance_opener", fields: [openedById], references: [id], onDelete: SetNull)

  @@index([subjectUserId])
  @@index([status])
  @@map("compliance_cases")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// Phase 10 slice 5 — daily USD-equivalent equity snapshots, used to draw
// the dashboard equity curve and compute 24h P&L. One row per
// (user, UTC date). The snapshot worker upserts so a re-run for the same
// day is idempotent.
//
// Lab cadence: the worker runs every 5 minutes instead of nightly so
// trainee demos see a live-moving curve. See apps/worker/src/equity-snapshot.ts.
model EquitySnapshot {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  totalUsd   Decimal  @db.Decimal(38, 8)
  computedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("equity_snapshots")
}
