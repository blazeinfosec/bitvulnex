// Prisma schema for BVBE.
//
// Phase 1 extends the User model and adds RefreshToken,
// PasswordResetToken, ApiKey. Subsequent phases extend additively.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  support
  compliance
  admin
  treasury
}

enum KycStatus {
  incomplete
  pending
  approved
  rejected
}

enum KycDocType {
  passport
  id_card
  address_proof
}

enum KycDocSource {
  upload
  url_import
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  role          Role      @default(user)
  kycTier       Int       @default(0)
  emailVerified Boolean   @default(false)
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  apiKeys            ApiKey[]
  kycProfile         KycProfile?
  kycDocuments       KycDocument[]

  @@map("users")
}

model KycProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  legalName       String?
  dateOfBirth     DateTime?
  country         String?
  addressLine     String?
  city            String?
  postalCode      String?
  status          KycStatus @default(incomplete)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_profiles")
}

model KycDocument {
  id         String       @id @default(cuid())
  userId     String
  type       KycDocType
  filename   String
  storedPath String
  mimeType   String
  size       Int
  source     KycDocSource @default(upload)
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_documents")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}
