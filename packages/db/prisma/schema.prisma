// Prisma schema for BVBE.
//
// Phase 0 baseline. Only the User model exists, with a single seeded
// admin row so Phase 1's signup flow has a counterparty. Subsequent
// phases extend this schema additively via migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  support
  compliance
  admin
  treasury
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  kycTier      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
