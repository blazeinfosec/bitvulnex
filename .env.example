# Blaze Vulnerable Bitcoin Exchange — local lab configuration.
#
# Copy to .env. All values shown here are placeholders for Phase 0.
# Production-shaped fallback values (some deliberately weak) will be
# added in Phase 1; Phase 0 ships strict, placeholder-only defaults.

# Core
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://bvbe:bvbe@db:5432/bvbe?schema=public

# Redis (cache + BullMQ)
REDIS_URL=redis://redis:6379

# JWT signing — strict, placeholder. Replace before running.
JWT_SECRET=replace-me-with-a-32-byte-random-secret

# Legacy v1 mobile-app HMAC secret. The verifier falls back to a
# known-weak default ("changeme") if this variable is undefined in
# the web container's process env. Override here if you want the
# legacy verifier wired to a known key for testing.
# JWT_SECRET_LEGACY=changeme

# Bitcoin mock node RPC (internal network only; not exposed via nginx)
BITCOIN_MOCK_URL=http://bitcoin-mock:18443

# CTF / lab mode toggles (instructor-controlled)
CTF_MODE=false
HINT_MODE=false
SCOREBOARD_ENABLED=false
CTF_SALT=change-me-per-cohort
