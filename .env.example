# Bitvulnex — Vulnerable Bitcoin Exchange — local lab configuration.
#
# Copy to .env before the first `docker compose up` (compose refuses to
# start without CTF_SALT).
#
# docker compose reads only the variables in the "Lab toggles" section
# at the bottom. The service wiring above it documents the values the
# containers use; the lab's own copies live in docker-compose.yml, and
# editing them here has no effect on the Docker stack. They matter only
# when you run a package directly on the host.

# Core
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://bvbe:bvbe@db:5432/bvbe?schema=public

# Redis (cache + BullMQ)
REDIS_URL=redis://redis:6379

# JWT signing. Host-only runs need a value of 32+ characters.
JWT_SECRET=replace-me-with-a-32-byte-random-secret

# Legacy v1 mobile-app HMAC secret. The verifier falls back to a
# known-weak default ("changeme") if this variable is undefined in
# the web container's process env. Override here if you want the
# legacy verifier wired to a known key for testing.
# JWT_SECRET_LEGACY=changeme

# Bitcoin mock node RPC (internal network only; not exposed via nginx)
BITCOIN_MOCK_URL=http://bitcoin-mock:18443

# ---------------------------------------------------------------------
# Lab toggles — read by docker compose. After changing any of these,
# run `docker compose up -d` again so the containers pick them up.
# ---------------------------------------------------------------------

# Host port the nginx edge is published on. The container always listens
# on 80; this only moves the host-side mapping. Set it to something like
# 8080 if port 80 is already taken on your host — then the URLs become
# http://localhost:8080/ . Leave at 80 for the documented default.
WEB_PORT=80

# --- Web tier capacity (host RAM knobs) ---------------------------
# Number of `next dev` processes in the API pool behind nginx. Total
# web containers = 1 (`web`: pages, /_next, HMR) + WEB_API_REPLICAS.
# Each dev server is an independent Node process with its own webpack
# module graph, so RAM scales close to linearly with this number —
# lower it first when the host is short on memory.
#
#   1  = lowest RAM, and the only setting where per-process state in
#        lib/global-store.ts (2FA login tickets, V-34's polluted
#        Object.prototype) is reliably visible to a follow-up request.
#   5  = as-shipped default; sized for a ~21-agent concurrent fleet.
#
# Changing it needs no nginx edit (request-time DNS round-robin), but
# use --remove-orphans when scaling down so retired replicas are torn
# down: WEB_API_REPLICAS=2 docker compose up -d --remove-orphans
WEB_API_REPLICAS=5

# V8 old-space ceiling per web container, in MB. A HARD cap: if next dev
# needs more during a heavy compile it fatally OOMs and the container
# exits (auto-recovered by `restart: unless-stopped`, but you still get a
# blip + cold restart). A light-route sweep showed 512 gave 2.86 GB tier
# vs 1024 -> 4.29 GB, so 512 looked great — but under REAL pentest load
# the pages server compiling heavy routes (/docs, /admin/kyc/*, PDF/XML)
# blew past 512 and OOM-crashed the tier (2026-08-07). Default is now
# 2048 for headroom (a replica was later seen riding a 1536 cap under
# load). Do NOT drop below ~1024 unless you have load-tested the heavy
# routes, not just /api/v2/me/*. It is still a real RAM lever (vs
# uncapped ~2-4 GB/proc) — just don't over-tighten it. On a memory-tight
# host, cut WEB_API_REPLICAS before raising this further.
WEB_NODE_HEAP_MB=2048

# V-34 pool watchdog (see docker-compose.yml `web-watchdog` +
# scripts/web-watchdog.sh). With COMPOSE_PROFILES=watchdog, a sidecar
# starts alongside the lab on `docker compose up -d` / `make up` and
# auto-restarts any web-api replica that a V-34 prototype-pollution
# trigger has poisoned into pool-wide 500s/hangs — so an automated
# pentest self-heals instead of stalling on a dead API. It restarts a
# replica only after WATCHDOG_FAIL_THRESHOLD consecutive failed polls
# (a transient blip never triggers a bounce). Comment out COMPOSE_PROFILES
# to run the lab WITHOUT auto-healing (e.g. to observe the raw DoS).
COMPOSE_PROFILES=watchdog
WATCHDOG_INTERVAL=10
WATCHDOG_FAIL_THRESHOLD=3

# CTF / lab mode toggles (instructor-controlled)
CTF_MODE=false
HINT_MODE=false
SCOREBOARD_ENABLED=false
# Rotate per cohort; flags are derived from it. Minimum 8 characters.
CTF_SALT=change-me-per-cohort

# Ambient activity simulator (fake customer deposits/trades).
# Set to false for a quiet, deterministic demo.
ACTIVITY_SIM_ENABLED=true
ACTIVITY_SIM_EVERY_MS=20000
